PORT=3000
HOST=0.0.0.0

# Generic headless CMS API settings.
CMS_BASE_URL=http://localhost:1337
CMS_API_TOKEN=
CMS_CONTENT_PATH=/api/content
CMS_HEALTH_PATH=/api/_health

# OpenAI-compatible chat completions API settings.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

ASSISTANT_NAME=CMS AI Assistant
ASSISTANT_SYSTEM_PROMPT=You are a CMS assistant that helps draft, improve, and find content using the connected CMS context.
ASSISTANT_MAX_CONTEXT_ITEMS=5
